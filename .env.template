# ================================================
# ================ DATABASE CONFIG ===============
# ================================================
DB_HOST=localhost
DB_PORT=3306
DB_NAME=dialogym
DB_USER=root
DB_PASS=your_database_password_here

# ================================================
# ================ SPRING CONFIG =================
# ================================================
SPRING_PROFILES_ACTIVE=local
SERVER_PORT=9090
JPA_DDL_AUTO=update

# ================================================
# ================ AI CONFIG =====================
# ================================================
# OpenAI API Key (필수 입력)
OPENAI_API_KEY=your_openai_api_key_here

# OpenAI Model Settings
OPENAI_MODEL=gpt-4o-mini
OPENAI_TEMPERATURE=0.7
OPENAI_MAX_TOKENS=2000

# ================================================
# ================ JWT CONFIG ====================
# ================================================
JWT_SECRET=your_jwt_secret_here
JWT_ACCESS_TOKEN_EXPIRATION=900000        # 15분
JWT_REFRESH_TOKEN_EXPIRATION=1209600000    # 14일

# ================================================
# ================ COOKIE CONFIG =================
# ================================================
COOKIE_ACCESS_TOKEN_NAME=accessToken
COOKIE_REFRESH_TOKEN_NAME=refreshToken
COOKIE_DOMAIN=localhost
COOKIE_PATH=/
COOKIE_ACCESS_TOKEN_MAX_AGE=900           # 초 단위
COOKIE_REFRESH_TOKEN_MAX_AGE=1209600       # 초 단위 (14일)
COOKIE_SECURE=false
COOKIE_SAME_SITE=Lax

# ================================================
# ================ CORS CONFIG ===================
# ================================================
CORS_ALLOWED_ORIGINS=http://localhost:5050

# ================================================
# ================ MAIL CONFIG ===================
# ================================================
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_app_password_here

# ================================================
# ================ OAUTH2 CONFIG =================
# ================================================
# Kakao
KAKAO_CLIENT_ID=your_kakao_client_id_here
KAKAO_CLIENT_SECRET=your_kakao_client_secret_here

# Google
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# Naver
NAVER_CLIENT_ID=your_naver_client_id_here
NAVER_CLIENT_SECRET=your_naver_client_secret_here

# ================================================
# ================ SCHEDULER CONFIG ==============
# ================================================
SCHEDULER_CLEANUP_TEMPORARY_DATA_HOURS=1   # 임시 데이터 정리 주기 (시간)
SCHEDULER_CLEANUP_REFRESH_TOKEN_DAYS=14    # RefreshToken 만료 후 삭제 주기 (일)
