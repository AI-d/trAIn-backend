# ===== Database Configuration =====
DB_HOST=localhost
DB_PORT=3306
DB_NAME=dialogym
DB_USER=root
DB_PASS=your_database_password

# ===== Spring Configuration =====
SPRING_PROFILES_ACTIVE=local
SERVER_PORT=9090
JPA_DDL_AUTO=update

# ===== AI Configuration =====
# OpenAI API Key (https://platform.openai.com/api-keys)
OPENAI_API_KEY=your-openai-api-key

# OpenAI Model Configuration
OPENAI_MODEL=gpt-4o-mini
OPENAI_TEMPERATURE=0.7
OPENAI_MAX_TOKENS=2000

# ===== JWT Configuration =====
# Generate a secure random key (minimum 256 bits)
# You can generate one using: openssl rand -base64 64
JWT_SECRET=your-jwt-secret-key-minimum-256-bits
JWT_ACCESS_TOKEN_EXPIRATION=3600000
JWT_REFRESH_TOKEN_EXPIRATION=1209600000

# ===== Cookie Configuration (HttpOnly) =====
# Cookie 이름
COOKIE_ACCESS_TOKEN_NAME=accessToken
COOKIE_REFRESH_TOKEN_NAME=refreshToken

# Cookie 도메인 (로컬: localhost, 프로덕션: yourdomain.com)
COOKIE_DOMAIN=localhost

# Cookie Path
COOKIE_PATH=/

# Cookie Max Age (초 단위)
COOKIE_ACCESS_TOKEN_MAX_AGE=3600
COOKIE_REFRESH_TOKEN_MAX_AGE=1209600

# Cookie Secure (HTTPS 전용, 로컬에서는 false)
COOKIE_SECURE=false

# Cookie SameSite (None, Lax, Strict)
COOKIE_SAME_SITE=Lax

# ===== CORS Configuration =====
# 허용할 Origin (프론트엔드 URL)
CORS_ALLOWED_ORIGINS=http://localhost:5050

# Frontend Base URL
FRONTEND_BASE_URL=http://localhost:5050

# OAuth Redirect Base URL
OAUTH_REDIRECT_BASE_URL=http://localhost:9090

# ===== Email Configuration (Gmail SMTP) =====
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
# Gmail 계정 (2단계 인증 활성화 후 앱 비밀번호 생성 필요)
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-gmail-app-password

# ===== OAuth2 Configuration =====
# Kakao (https://developers.kakao.com/)
KAKAO_CLIENT_ID=your-kakao-client-id
KAKAO_CLIENT_SECRET=your-kakao-client-secret

# Google (https://console.cloud.google.com/)
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Naver (https://developers.naver.com/)
NAVER_CLIENT_ID=your-naver-client-id
NAVER_CLIENT_SECRET=your-naver-client-secret

# ===== Scheduler Configuration =====
# 임시 데이터 정리 주기 (시간)
SCHEDULER_CLEANUP_TEMPORARY_DATA_HOURS=1
# RefreshToken 만료 후 삭제 주기 (일)
SCHEDULER_CLEANUP_REFRESH_TOKEN_DAYS=14
